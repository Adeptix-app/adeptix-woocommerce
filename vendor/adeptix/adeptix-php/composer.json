{
    "name": "adeptix/adeptix-php",
    "description": "Official PHP SDK for the Adeptix API - crypto payments and merchant payments.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://docs.adeptix.app",
    "keywords": ["adeptix", "payments", "crypto", "payment-gateway", "api-client"],
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Adeptix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Adeptix\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
